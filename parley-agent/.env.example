# The model parley-action thinks with: a Mastra `provider/id` string.
# Parley users already hold a Groq key (transcription), so Groq is the default.
PARLEY_MODEL=groq/openai/gpt-oss-20b
GROQ_API_KEY=

# Or point at anything else the Mastra model gateway knows:
# PARLEY_MODEL=openrouter/openai/gpt-4o-mini
# OPENROUTER_API_KEY=

# Where the MCP servers live: a JSON object shaped like the MCPClient
# `servers` map. Missing file means no servers (the Agent tab says so).
#   { "calendar": { "command": "npx", "args": ["-y", "calendar-mcp"] },
#     "github": { "url": "http://localhost:3000/mcp" } }
PARLEY_MCP_SERVERS_FILE=./mcp-servers.json

# Keyless end-to-end verification (see README): PARLEY_MODEL=mock:read,
# mock:write or mock:plain with the fixture server in mcp-servers.smoke.json.

# One line per Mastra stream chunk while a run pumps. Off unless '1'.
# PARLEY_DEBUG=1
