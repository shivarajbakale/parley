{
  "compilerOptions": {
    "target": "ES2022",
    // DOM for the fetch, FormData, Blob and AbortController globals Node ships.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["engine", "scripts", "vitest.config.ts"]
}
