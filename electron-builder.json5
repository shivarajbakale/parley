// @see - https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'parley',
  asar: true,
  afterPack: 'scripts/adhoc-sign.cjs',
  productName: 'Parley',
  directories: {
    output: 'release/${version}',
  },
  files: ['dist', 'dist-electron'],
  asarUnpack: ['node_modules/uiohook-napi/**'],
  mac: {
    // The Accessibility reader voice edit uses; see scripts/build-ax-helper.sh.
    extraResources: [{ from: 'resources/parley-ax', to: 'parley-ax' }],
    icon: 'build/icon.icns',
    target: ['dmg'],
    // No Developer ID yet: skip electron-builder's signing, scripts/adhoc-sign.cjs signs ad hoc.
    identity: null,
    artifactName: '${productName}-Mac-${version}-Installer.${ext}',
    extendInfo: {
      LSUIElement: true,
      NSMicrophoneUsageDescription: 'Parley records your voice while you hold the dictation key.',
    },
  },
  win: {
    target: [
      {
        target: 'nsis',
        arch: ['x64'],
      },
    ],
    artifactName: '${productName}-Windows-${version}-Setup.${ext}',
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  linux: {
    target: ['AppImage'],
    artifactName: '${productName}-Linux-${version}.${ext}',
  },
}
