        "docs/loops/loop-state.schema.json": "@schema",
        "docs/loops/feature-002.goal.json": "{\"feature\":\"feature-002\",\"outcome\":\"It works.\",\"scope\":[\"a thing\"],\"exclusions\":[],\"verification\":[{\"id\":\"gate\",\"check\":\"green\",\"command\":\"make check\"}]}\n"
      },
      "violations": [{ "rule": "L1", "match": "has no `exclusions`" }]
    },
    {
