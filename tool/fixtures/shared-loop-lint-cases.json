        "docs/loops/feature-002.goal.json": "{\"feature\":\"feature-002\",\"outcome\":\"It works.\",\"scope\":[\"a thing\"],\"exclusions\":[\"another\"],\"verification\":[{\"id\":\"gate\",\"check\":\"green\"}]}\n"
