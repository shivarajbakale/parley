{
  "name": "parley",
  "private": true,
  "version": "0.6.4",
  "type": "module",
  "description": "Parley's engine: the dictation session, gestures, transcription and dictionary, run headless under Node by the native macOS app in macos/.",
  "scripts": {
    "build:engine": "bash scripts/build-engine.sh",
    "build:agent": "bash scripts/build-agent.sh",
    "lint": "eslint . --ext ts --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skill-lint": "node scripts/skill-lint.mjs",
    "feature-plan": "node scripts/feature-plan.mjs",
    "plan-lint": "node scripts/plan-lint.mjs",
    "doc-lint": "node scripts/doc-lint.mjs --strict",
    "loop-lint": "node scripts/loop-lint.mjs --strict"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.57.0",
    "prettier": "^3.5.3",
    "typescript": "^5.2.2",
    "vitest": "^3.2.7",
    "esbuild": "^0.25.0"
  },
  "license": "Apache-2.0"
}
