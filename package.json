{
  "name": "parley",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "build:ax-helper": "bash scripts/build-ax-helper.sh",
    "predev": "npm run build:ax-helper",
    "dev": "vite",
    "prebuild": "npm run build:ax-helper",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "ui-lint": "node scripts/ui-lint.mjs",
    "capability-lint": "node scripts/capability-lint.mjs",
    "doc-links": "node scripts/doc-links.mjs",
    "ui-probe": "vitest run --config vitest.ui-probe.config.ts",
    "storybook-lint": "node scripts/storybook-lint.mjs",
    "skill-lint": "node scripts/skill-lint.mjs",
    "storybook-render": "node scripts/storybook-render.mjs --build",
    "storybook-docs": "node scripts/gen-storybook-docs.mjs",
    "feature-plan": "node scripts/feature-plan.mjs",
    "plan-lint": "node scripts/plan-lint.mjs",
    "doc-lint": "node scripts/doc-lint.mjs --strict",
    "loop-lint": "node scripts/loop-lint.mjs --strict"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@mantine/carousel": "^9.6.0",
    "@mantine/charts": "^9.6.0",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/modals": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@mantine/spotlight": "^9.6.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.62.18",
    "@tanstack/react-router": "^1.114.17",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.8.4",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.482.0",
    "motion": "^13.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.1.0",
    "recharts": "^3.1.0",
    "uiohook-napi": "^1.5.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/react-vite": "^9.1.0",
    "@tanstack/react-query-devtools": "^5.62.18",
    "@tanstack/react-router-devtools": "^1.114.21",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "msw": "^2.11.5",
    "msw-storybook-addon": "^3.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.5.3",
    "remark-gfm": "^4.0.1",
    "storybook": "^9.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  },
  "main": "dist-electron/main.js",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
