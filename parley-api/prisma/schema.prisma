// Prisma schema — SQLite by default. Swap `provider` to "postgresql" / "mysql"
// and update DATABASE_URL in .env to move to another database.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String   @default("")
  createdAt DateTime @default(now())
  tokens    ApiToken[]
  dictionary DictionaryEntry[]
  settings  SettingsBlob[]
  history   HistoryItem[]
  tasks     Task[]

  @@map("users")
}

model ApiToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  label     String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("api_tokens")
}

// Sync rows. `updatedAt` and `deletedAt` are client clocks in ms since the
// epoch (BigInt), not DateTime: last-writer-wins compares the numbers the
// clients wrote, and SQLite DateTime would round them.

model DictionaryEntry {
  id         String
  userId     String
  word       String
  soundsLike String  @default("[]") // JSON string[]
  updatedAt  BigInt
  deletedAt  BigInt?
  syncedAt  BigInt // server ms, set on every write: the pull cursor
  user       User    @relation(fields: [userId], references: [id])

  @@id([userId, id])
  @@index([userId, syncedAt])
  @@map("dictionary_entries")
}

model SettingsBlob {
  id        String // one row per user: id == userId
  userId    String
  data      String  @default("{}") // JSON, never API keys
  updatedAt BigInt
  deletedAt BigInt?
  syncedAt BigInt // server ms, set on every write: the pull cursor
  user      User    @relation(fields: [userId], references: [id])

  @@id([userId, id])
  @@index([userId, syncedAt])
  @@map("settings_blobs")
}

model HistoryItem {
  id        String
  userId    String
  mode      String
  text      String
  app       String  @default("")
  createdAt BigInt
  updatedAt BigInt
  deletedAt BigInt?
  syncedAt BigInt // server ms, set on every write: the pull cursor
  user      User    @relation(fields: [userId], references: [id])

  @@id([userId, id])
  @@index([userId, syncedAt])
  @@map("history_items")
}

model Task {
  id         String
  userId     String
  title      String
  notes      String  @default("")
  dueAt      BigInt?
  rrule      String?
  priority   String  @default("medium")
  status     String  @default("open")
  sourceText String  @default("")
  updatedAt  BigInt
  deletedAt  BigInt?
  syncedAt  BigInt // server ms, set on every write: the pull cursor
  user       User    @relation(fields: [userId], references: [id])

  @@id([userId, id])
  @@index([userId, syncedAt])
  @@map("tasks")
}
