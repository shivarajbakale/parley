{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/harness-session-start.mjs",
            "timeout": 10,
            "statusMessage": "Loading project harness context..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/harness-stop-check.mjs",
            "timeout": 900,
            "statusMessage": "Running clean-state check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-on-edit.mjs",
            "timeout": 30,
            "statusMessage": "Linting the edited file..."
          }
        ]
      }
    ]
  }
}
