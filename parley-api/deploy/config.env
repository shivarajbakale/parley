# Deploy settings for deploy/deploy.sh. Plain KEY=value, sourced by bash.
# Yours to edit — the installer never overwrites this file.

# Tailscale node name: the app lives at https://<NODE_NAME>.<TAILNET>
NODE_NAME=parley-api

# Port the served service listens on inside its container.
SERVE_PORT=3100

# Tailnet suffix, only used to print the URL.
TAILNET=taile506df.ts.net

# Space-separated paths that must return 200 after a deploy, or it fails.
# Add the routes a healthy container can still break, e.g. "/api/health /api/inngest".
HEALTH_PATHS="/"

# Compose file ts-deploy reads, and where the project lands on the host ($HOME-relative).
COMPOSE_FILE=compose.ts-deploy.yml
REMOTE_DIR=projects/parley-api

# Extra rsync excludes (space-separated) — anything the image is not built from.
RSYNC_EXCLUDES="docs test .data"

# Printed before a public deploy. Name what becomes world-readable.
PUBLIC_WARNING="Do not. /api/providers spends the provider keys and has no auth; only the tailnet keeps it private."
