{
  "name": "parley-api",
  "version": "1.0.0",
  "description": "Parley API: Mastra on Express",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run test",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "@mastra/core": "1.67.0",
    "@mastra/express": "^1.5.18",
    "exa-js": "^2.25.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
