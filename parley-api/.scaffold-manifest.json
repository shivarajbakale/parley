{
  "manifestVersion": 1,
  "scaffolder": "create-express-app",
  "scaffolderVersion": "0.1.0",
  "framework": "express",
  "language": "typescript",
  "category": "backend",
  "projectName": "parley-api",
  "description": "Parley sync API",
  "entrypoint": "src/server.ts",
  "scripts": {
    "dev": "npm run dev",
    "build": "npm run build",
    "start": "npm start",
    "test": "npm test"
  },
  "defaultPort": 3000,
  "healthcheck": {
    "path": "/api/health",
    "expectedStatus": 200
  },
  "packageManager": "npm",
  "capabilities": [
    "express",
    "typescript",
    "prisma",
    "zod",
    "winston"
  ],
  "monorepoHints": {
    "packageNameField": "package.json#name",
    "tsconfigExtendsField": "tsconfig.json#extends",
    "portEnvVar": "PORT"
  }
}
