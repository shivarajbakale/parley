PORT=3100
# Loopback by default: /api/providers spends the keys below.
HOST=127.0.0.1
# The model agents think with: a Mastra `provider/id` string.
PARLEY_MODEL=minimax/MiniMax-M3
# Voice edit, Explain and the Act agent.
MINIMAX_API_KEY=
# Dictation: Groq's Whisper, or Deepgram when that provider is picked in Settings.
GROQ_API_KEY=
DEEPGRAM_API_KEY=
# Web search for the screen explainer. Unset means the agent answers without search.
EXA_API_KEY=
